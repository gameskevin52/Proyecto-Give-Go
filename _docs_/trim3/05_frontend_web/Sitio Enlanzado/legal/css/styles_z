/*CSS*/

.cat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.05);
}

.cat-card h5 {
    font-size: 1rem;
    color: #2D3748;
}

.cat-card small {
    font-size: 0.8rem;
    opacity: 0.7;
}

/* Colores de fondo pasteles (iguales a la imagen) */
.bg-soft-green { background-color: #E6FFFA; }
.bg-soft-blue { background-color: #EBF8FF; }
.bg-soft-mint { background-color: #F0FFF4; }
.bg-soft-orange { background-color: #FFFAF0; }
.bg-soft-purple { background-color: #FAF5FF; }
.bg-soft-pink { background-color: #FFF5F7; }
.bg-soft-yellow { background-color: #FFFFF0; }
.bg-soft-cyan { background-color: #E6FFFA; }

.footer-custom {
    background-color: #0B111F; /* El azul oscuro exacto de la imagen */
    color: #ffffff;
    padding: 100px 0 40px 0;
    font-size: 14px;
}

.footer-brand {
    font-size: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.heart-icon { color: #FF0000; }

.footer-description {
    color: #94A3B8; /* Color gris suave */
    max-width: 350px;
    line-height: 1.6;
    margin-top: 20px;
}

/* Títulos de las columnas (PLATAFORMA, LEGAL, etc.) */
.footer-heading {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #E2E8F0;
    margin-bottom: 20px;
}

/* Enlaces del footer */
.footer-list li { margin-bottom: 12px; }
.footer-list a {
    color: #94A3B8;
    text-decoration: none;
    transition: 0.3s;
}
.footer-list a:hover { color: #ffffff; }

/* Círculos de redes sociales con borde sutil */
.social-circle {
    width: 32px;
    height: 32px;
    border: 1px solid #475569;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: #94A3B8;
    cursor: pointer;
    transition: 0.3s;
}
.social-circle:hover {
    border-color: #ffffff;
    color: #ffffff;
}

/* Línea de copyright */
.footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.05);
    color: #64748B;
    font-size: 12px;
}

/* Círculos de redes sociales */
.social-icon {
    width: 35px;
    height: 35px;
    background-color: rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: white;
    font-style: normal;
    font-size: 0.8rem;
    transition: 0.3s;
}

.social-icon:hover {
    background-color: var(--primary-red);
}
/* Contenedor principal con el azul muy oscuro de la imagen */
.footer-custom {
    background-color: #0d1421; /* Azul noche profundo */
    color: #ffffff;
    padding: 60px 0;
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* Marca: Logo y Nombre */
.footer-brand {
    font-size: 1.6rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 25px;
}

.heart-icon {
    font-size: 1.5rem;
}

/* Descripción con opacidad para ese tono grisáceo */
.footer-description {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 380px;
    margin-bottom: 30px;
}

/* Redes Sociales: Círculos con fondo sutil */
.social-circle {
    width: 40px;
    height: 40px;
    background-color: rgba(255, 255, 255, 0.1); /* Círculo semitransparente */
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9rem;
    transition: background 0.3s ease;
    cursor: pointer;
}

.social-circle:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

/* Títulos de secciones (PLATAFORMA, COMUNIDAD, etc.) */
.footer-heading {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 25px;
}

/* Enlaces de las listas */
.footer-list {
    padding: 0;
}

.footer-list li {
    margin-bottom: 15px;
}

.footer-list a {
    color: rgba(255, 255, 255, 0.6); /* Color apagado como en la foto */
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.3s ease;
}

.footer-list a:hover {
    color: #ffffff;
}

/* Sección LEGAL separada abajo a la izquierda */
.mt-5 {
    margin-top: 60px !important;
}
a{
